{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chndemirpence/recourse/standard/dispute-template.schema.json",
  "title": "Open Dispute-Template Standard (ODTS) v0.1",
  "type": "object",
  "required": ["odts_version", "id", "version", "title", "category", "unit", "jurisdictions", "channel", "fields", "rights", "ladder", "artifact", "disclaimer"],
  "additionalProperties": false,
  "properties": {
    "odts_version": { "const": "0.1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "unit": { "enum": ["money", "time", "task"] },
    "est_value_hint": { "type": "number", "minimum": 0 },
    "jurisdictions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "channel": { "type": "string", "minLength": 1 },
    "goal_default": { "type": "string" },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "label"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "placeholder": { "type": "string" }
        }
      }
    },
    "rights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "basis", "jurisdiction"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "basis": { "type": "string", "minLength": 1 },
          "jurisdiction": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ladder": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "artifact": {
      "type": "object",
      "required": ["type", "body"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["email", "letter", "script"] },
        "subject": { "type": "string" },
        "body": { "type": "string", "minLength": 1 }
      }
    },
    "disclaimer": { "type": "string", "minLength": 1 }
  }
}
